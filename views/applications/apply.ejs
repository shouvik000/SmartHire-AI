<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Apply | SmartHire AI</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">


    <!-- ===================================== -->
    <!-- NAVBAR -->
    <!-- ===================================== -->

    <nav class="navbar navbar-dark bg-dark">

        <div class="container">

            <a
                class="navbar-brand"
                href="/jobs"
            >
                🤖 SmartHire AI
            </a>

            <a
                href="/jobs"
                class="btn btn-outline-light btn-sm"
            >
                ← Back to Jobs
            </a>

        </div>

    </nav>



    <!-- ===================================== -->
    <!-- MAIN CONTAINER -->
    <!-- ===================================== -->

    <div class="container mt-5 mb-5">

        <div class="row justify-content-center">

            <div class="col-md-8">


                <!-- ===================================== -->
                <!-- APPLICATION CARD -->
                <!-- ===================================== -->

                <div class="card shadow">


                    <!-- CARD HEADER -->

                    <div class="card-header bg-primary text-white">

                        <h3 class="mb-0">
                            🚀 Apply for Job
                        </h3>

                    </div>



                    <!-- CARD BODY -->

                    <div class="card-body">


                        <!-- ===================================== -->
                        <!-- JOB INFORMATION -->
                        <!-- ===================================== -->

                        <div class="alert alert-info">

                            <h5>
                                <strong>
                                    <%= job.title %>
                                </strong>
                            </h5>

                            <hr>

                            <p class="mb-1">

                                <strong>
                                    Company:
                                </strong>

                                <%= job.company %>

                            </p>


                            <p class="mb-1">

                                <strong>
                                    Location:
                                </strong>

                                <%= job.location %>

                            </p>


                            <p class="mb-1">

                                <strong>
                                    Salary:
                                </strong>

                                <%= job.salary || "Not specified" %>

                            </p>


                            <p class="mb-0">

                                <strong>
                                    Required Skills:
                                </strong>

                                <%= job.required_skills || "Not specified" %>

                            </p>

                        </div>



                        <!-- ===================================== -->
                        <!-- APPLICATION FORM -->
                        <!-- ===================================== -->

                        <form
                            action="/apply/<%= job.id %>"
                            method="POST"
                            enctype="multipart/form-data"
                        >


                            <!-- ================================= -->
                            <!-- FULL NAME -->
                            <!-- ================================= -->

                            <div class="mb-3">

                                <label
                                    for="applicant_name"
                                    class="form-label"
                                >

                                    <strong>
                                        Full Name
                                    </strong>

                                </label>


                                <input
                                    type="text"
                                    id="applicant_name"
                                    name="applicant_name"
                                    class="form-control"
                                    placeholder="Enter your full name"
                                    required
                                >

                            </div>



                            <!-- ================================= -->
                            <!-- EMAIL -->
                            <!-- ================================= -->

                            <div class="mb-3">

                                <label
                                    for="email"
                                    class="form-label"
                                >

                                    <strong>
                                        Email Address
                                    </strong>

                                </label>


                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="example@gmail.com"
                                    required
                                >

                            </div>



                            <!-- ================================= -->
                            <!-- PHONE -->
                            <!-- ================================= -->

                            <div class="mb-3">

                                <label
                                    for="phone"
                                    class="form-label"
                                >

                                    <strong>
                                        Phone Number
                                    </strong>

                                </label>


                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    class="form-control"
                                    placeholder="Enter your phone number"
                                    required
                                >

                            </div>



                            <!-- ================================= -->
                            <!-- SKILLS -->
                            <!-- ================================= -->

                            <div class="mb-3">

                                <label
                                    for="skills"
                                    class="form-label"
                                >

                                    <strong>
                                        Your Skills
                                    </strong>

                                </label>


                                <input
                                    type="text"
                                    id="skills"
                                    name="skills"
                                    class="form-control"
                                    placeholder="Node.js, Express.js, PostgreSQL, JavaScript"
                                >


                                <div class="form-text">

                                    Enter your skills separated by commas.

                                    Example:

                                    <strong>
                                        Node.js, Express.js, PostgreSQL
                                    </strong>

                                </div>

                            </div>



                            <!-- ================================= -->
                            <!-- RESUME -->
                            <!-- ================================= -->

                            <div class="mb-3">

                                <label
                                    for="resume"
                                    class="form-label"
                                >

                                    <strong>
                                        Upload Resume
                                    </strong>

                                </label>


                                <input
                                    type="file"
                                    id="resume"
                                    name="resume"
                                    class="form-control"
                                    accept=".pdf,.docx,.txt"
                                    required
                                >


                                <div class="form-text">

                                    Upload your resume in
                                    <strong>
                                        PDF, DOCX, or TXT
                                    </strong>
                                    format.

                                    The resume will be analyzed
                                    for job-skill matching.

                                </div>

                            </div>



                            <!-- ================================= -->
                            <!-- COVER LETTER -->
                            <!-- ================================= -->

                            <div class="mb-4">

                                <label
                                    for="cover_letter"
                                    class="form-label"
                                >

                                    <strong>
                                        Cover Letter
                                    </strong>

                                </label>


                                <textarea
                                    id="cover_letter"
                                    name="cover_letter"
                                    class="form-control"
                                    rows="5"
                                    placeholder="Explain why you are suitable for this job..."
                                ></textarea>

                            </div>



                            <!-- ================================= -->
                            <!-- SUBMIT BUTTON -->
                            <!-- ================================= -->

                            <button
                                type="submit"
                                class="btn btn-success w-100"
                            >

                                🚀 Submit Application

                            </button>


                        </form>


                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ===================================== -->
    <!-- FOOTER -->
    <!-- ===================================== -->

    <footer class="text-center text-muted py-4">

        <small>
            © 2026 SmartHire AI
        </small>

    </footer>


</body>

</html>