<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Applications | SmartHire AI</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f4f6f9;
        }

        .navbar-brand {
            font-weight: 700;
        }

        .application-card {
            border: none;
            border-radius: 18px;
            transition: 0.3s;
        }

        .application-card:hover {
            transform: translateY(-5px);
        }

        .match-score {
            font-size: 28px;
            font-weight: 700;
        }

        .skill-badge {
            margin: 3px;
        }

        .empty-box {
            margin-top: 80px;
            padding: 50px;
            border-radius: 20px;
            background: white;
        }

    </style>

</head>


<body>



<!-- NAVBAR -->


<nav class="navbar navbar-dark bg-dark">

    <div class="container">

        <a
            class="navbar-brand"
            href="/dashboard"
        >
            🚀 SmartHire AI
        </a>

        <div>

            <a
                href="/dashboard"
                class="btn btn-outline-light me-2"
            >
                Dashboard
            </a>

            <a
                href="/jobs"
                class="btn btn-primary"
            >
                💼 Jobs
            </a>

        </div>

    </div>

</nav>



<!-- MAIN CONTENT -->


<div class="container py-5">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                📋 Applications
            </h2>

            <p class="text-muted mb-0">
                Applications received for your posted jobs
            </p>

        </div>

    </div>


   
    <!-- NO APPLICATIONS -->
    

    <% if (!applications || applications.length === 0) { %>

        <div class="empty-box text-center shadow-sm">

            <div style="font-size: 60px;">
                📭
            </div>

            <h3 class="mt-3">
                No Applications Yet
            </h3>

            <p class="text-muted">
                Applications submitted for your jobs will appear here.
            </p>

            <a
                href="/jobs"
                class="btn btn-primary mt-2"
            >
                View Jobs
            </a>

        </div>

    <% } else { %>


       
        <!-- APPLICATION CARDS -->
        

        <div class="row g-4">

            <% applications.forEach(application => { %>

                <div class="col-lg-6">

                    <div class="card application-card shadow-sm h-100">

                        <div class="card-body p-4">


                            
                            <!-- HEADER -->

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <h4 class="fw-bold text-primary mb-1">

                                        <%= application.applicant_name || "Applicant" %>

                                    </h4>

                                    <p class="text-muted mb-0">

                                        Applied for:
                                        <strong>
                                            <%= application.job_title || "Job" %>
                                        </strong>

                                    </p>

                                </div>


                                <!-- MATCH SCORE -->

                                <div class="text-center">

                                    <div class="match-score text-success">

                                        <%= application.match_score || 0 %>%

                                    </div>

                                    <small class="text-muted">
                                        Match Score
                                    </small>

                                </div>

                            </div>


                            <hr>


                            
                            <!-- APPLICANT INFORMATION -->
                           

                            <p>

                                <strong>📧 Email:</strong>

                                <%= application.email || "Not provided" %>

                            </p>


                            <p>

                                <strong>📞 Phone:</strong>

                                <%= application.phone || "Not provided" %>

                            </p>


                            <p>

                                <strong>🛠 Skills:</strong>

                                <%= application.skills || "Not provided" %>

                            </p>


                            <!-- ================================= -->
                            <!-- STATUS -->
                            <!-- ================================= -->

                            <p>

                                <strong>📌 Status:</strong>

                                <% if (application.status === "Accepted") { %>

                                    <span class="badge bg-success">
                                        ✅ Accepted
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-warning text-dark">
                                        🕐 Applied
                                    </span>

                                <% } %>

                            </p>


                            
                            <!-- MATCH INFORMATION -->
                            

                            <% if (application.matched_skills) { %>

                                <div class="mt-3">

                                    <strong>
                                        ✅ Matched Skills
                                    </strong>

                                    <p class="text-success mt-1">

                                        <%= application.matched_skills %>

                                    </p>

                                </div>

                            <% } %>


                            <% if (application.missing_skills) { %>

                                <div class="mt-2">

                                    <strong>
                                        ❌ Missing Skills
                                    </strong>

                                    <p class="text-danger mt-1">

                                        <%= application.missing_skills %>

                                    </p>

                                </div>

                            <% } %>


                            
                            <!-- COVER LETTER -->
                           
                            <% if (application.cover_letter) { %>

                                <div class="mt-3">

                                    <strong>
                                        📝 Cover Letter
                                    </strong>

                                    <p class="text-muted mt-1">

                                        <%= application.cover_letter %>

                                    </p>

                                </div>

                            <% } %>


                            <hr>


                           
                            <!-- ACTION BUTTONS -->
                            

                            <div class="d-grid gap-2">


                                <!-- VIEW APPLICATION -->

                                <a
                                    href="/applications/<%= application.id %>"
                                    class="btn btn-primary"
                                >
                                    🔎 View Application
                                </a>


                                <!-- VIEW RESUME -->

                                <% if (application.resume_link) { %>

                                    <a
                                        href="/uploads/<%= application.resume_link %>"
                                        target="_blank"
                                        class="btn btn-outline-primary"
                                    >
                                        📄 View Resume
                                    </a>

                                <% } else { %>

                                    <button
                                        class="btn btn-outline-secondary"
                                        disabled
                                    >
                                        📄 Resume Not Available
                                    </button>

                                <% } %>


                                <!-- ACCEPT -->

                                <% if (application.status !== "Accepted") { %>

                                    <form
                                        action="/applications/<%= application.id %>/accept"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-success w-100"
                                        >
                                            ✅ Accept Application
                                        </button>

                                    </form>

                                <% } %>


                                <!-- DELETE -->

                                <form
                                    action="/applications/<%= application.id %>/delete"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this application?');"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-danger w-100"
                                    >
                                        🗑 Delete Application
                                    </button>

                                </form>


                            </div>


                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>


</div>


</body>

</html>