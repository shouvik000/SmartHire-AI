

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Applications | SmartHire AI</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">


<!-- ================================================== -->
<!-- NAVBAR -->
<!-- ================================================== -->

<nav class="navbar navbar-dark bg-dark">

    <div class="container">

        <a
            class="navbar-brand fw-bold"
            href="/dashboard"
        >
            🚀 SmartHire AI
        </a>


        <div>

            <a
                href="/dashboard"
                class="btn btn-outline-light me-2"
            >
                Dashboard
            </a>


            <a
                href="/jobs"
                class="btn btn-outline-light"
            >
                Jobs
            </a>

        </div>

    </div>

</nav>



<!-- ================================================== -->
<!-- MAIN CONTENT -->
<!-- ================================================== -->

<div class="container mt-5">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                📋 Applications
            </h2>

            <p class="text-muted mb-0">
                Applications received for your jobs
            </p>

        </div>

    </div>



    <!-- ================================================== -->
    <!-- NO APPLICATIONS -->
    <!-- ================================================== -->

    <% if (!applications || applications.length === 0) { %>

        <div class="alert alert-info shadow-sm">

            <h5>
                📭 No Applications Yet
            </h5>

            <p class="mb-0">
                No candidates have applied to your jobs yet.
            </p>

        </div>


    <% } else { %>



        <!-- ================================================== -->
        <!-- APPLICATION CARDS -->
        <!-- ================================================== -->

        <div class="row">


            <% applications.forEach(application => { %>


                <div class="col-md-6 col-lg-4 mb-4">


                    <div class="card shadow-sm h-100">


                        <div class="card-body">


                            <!-- Candidate -->

                            <h4 class="text-primary">

                                <%= application.applicant_name %>

                            </h4>


                            <hr>


                            <!-- Job -->

                            <p>

                                <strong>
                                    💼 Job:
                                </strong>

                                <%= application.job_title || "N/A" %>

                            </p>



                            <!-- Company -->

                            <p>

                                <strong>
                                    🏢 Company:
                                </strong>

                                <%= application.company || "N/A" %>

                            </p>



                            <!-- Location -->

                            <p>

                                <strong>
                                    📍 Location:
                                </strong>

                                <%= application.location || "N/A" %>

                            </p>



                            <!-- Email -->

                            <p>

                                <strong>
                                    📧 Email:
                                </strong>

                                <%= application.email %>

                            </p>



                            <!-- Phone -->

                            <p>

                                <strong>
                                    📞 Phone:
                                </strong>

                                <%= application.phone %>

                            </p>



                            <!-- Skills -->

                            <p>

                                <strong>
                                    🛠 Skills:
                                </strong>

                                <%= application.skills || "Not specified" %>

                            </p>



                            <!-- ================================================== -->
                            <!-- MATCH SCORE -->
                            <!-- ================================================== -->

                            <div class="mb-3">

                                <strong>
                                    🤖 Resume Match:
                                </strong>


                                <%

                                    const score =
                                        Number(
                                            application.match_score || 0
                                        );

                                    let badgeClass = "bg-danger";
                                    let resultText = "Low Match";


                                    if (score >= 70) {

                                        badgeClass = "bg-success";
                                        resultText = "Excellent Match";

                                    } else if (score >= 40) {

                                        badgeClass = "bg-warning text-dark";
                                        resultText = "Good Match";

                                    }

                                %>


                                <span
                                    class="badge <%= badgeClass %>"
                                >

                                    <%= score %>%

                                </span>


                                <small class="text-muted">

                                    <%= resultText %>

                                </small>

                            </div>



                            <!-- ================================================== -->
                            <!-- STATUS -->
                            <!-- ================================================== -->

                            <p>

                                <strong>
                                    📌 Status:
                                </strong>


                                <% if (application.status === "Accepted") { %>

                                    <span class="badge bg-success">
                                        Accepted
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-secondary">
                                        Applied
                                    </span>

                                <% } %>

                            </p>



                            <!-- ================================================== -->
                            <!-- ACTION BUTTONS -->
                            <!-- ================================================== -->

                            <div class="d-grid gap-2 mt-4">


                                <!-- VIEW APPLICATION -->

                                <a
                                    href="/applications/<%= application.id %>"
                                    class="btn btn-primary"
                                >

                                    🔎 View Application

                                </a>



                                <!-- ================================================== -->
                                <!-- VIEW RESUME -->
                                <!-- IMPORTANT: CLOUDINARY URL -->
                                <!-- ================================================== -->

                                <% if (application.resume_link) { %>

                                    <a
                                        
                                     href="/resume/view/<%= application.id %>"
                                     target="_blank"
                                     rel="noopener noreferrer"
                                    class="btn btn-outline-dark"
                                >
                                    📄 View Resume
                                    </a>

                                <% } else { %>

                                    <button
                                        class="btn btn-outline-secondary"
                                        disabled
                                    >

                                        📄 Resume Not Available

                                    </button>

                                <% } %>



                                <!-- ================================================== -->
                                <!-- ACCEPT -->
                                <!-- ================================================== -->

                                <% if (application.status !== "Accepted") { %>

                                    <form
                                        action="/applications/<%= application.id %>/accept"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-success w-100"
                                            onclick="return confirm('Accept this application?')"
                                        >

                                            ✅ Accept Application

                                        </button>

                                    </form>

                                <% } %>



                                <!-- ================================================== -->
                                <!-- DELETE -->
                                <!-- ================================================== -->

                                <form
                                    action="/applications/<%= application.id %>/delete"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-danger w-100"
                                        onclick="return confirm('Delete this application?')"
                                    >

                                        🗑️ Delete Application

                                    </button>

                                </form>


                            </div>


                        </div>

                    </div>

                </div>


            <% }) %>


        </div>


    <% } %>


</div>



<!-- ================================================== -->
<!-- FOOTER -->
<!-- ================================================== -->

<footer class="bg-dark text-white text-center mt-5 p-4">

    <p class="mb-0">

        🚀 SmartHire AI © 2026

    </p>

</footer>


</body>

</html>
