<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Applications | SmartHire AI</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f4f7fb;
        }

        .application-card {
            border: none;
            border-radius: 15px;
            transition: 0.2s;
        }

        .application-card:hover {
            transform: translateY(-2px);
        }

        .match-score {
            font-size: 22px;
            font-weight: bold;
        }

        .applicant-avatar {
            width: 50px;
            height: 50px;
            min-width: 50px;
            border-radius: 50%;
            background: #0d6efd;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .skills-box {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 12px;
        }

        .cover-box {
            background: #f8f9fa;
            border-left: 4px solid #0d6efd;
            padding: 12px 15px;
            border-radius: 5px;
        }

    </style>

</head>


<body>


<div class="container mt-5 mb-5">


    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>
                📋 My Job Applications
            </h2>

            <p class="text-muted mb-0">

                Applications received for jobs posted by you

            </p>

        </div>


        <a
            href="/jobs"
            class="btn btn-primary"
        >

            ← Back to Jobs

        </a>

    </div>


    <!-- NO APPLICATIONS -->

    <% if (!applications || applications.length === 0) { %>


        <div class="card shadow application-card">

            <div class="card-body text-center p-5">

                <div style="font-size: 55px;">
                    📭
                </div>

                <h4 class="mt-3">
                    No Applications Yet
                </h4>

                <p class="text-muted">

                    No candidates have applied
                    to your jobs yet.

                </p>


                <a
                    href="/jobs"
                    class="btn btn-primary"
                >

                    View My Jobs

                </a>

            </div>

        </div>


    <% } else { %>


        <!-- APPLICATION COUNT -->

        <div class="alert alert-info">

            <strong>
                <%= applications.length %>
            </strong>

            application(s) received for your jobs.

        </div>


        <!-- APPLICATION LIST -->

        <% applications.forEach((application, index) => { %>


            <div class="card shadow-sm application-card mb-4">

                <div class="card-body">


                    <!-- TOP SECTION -->

                    <div class="row align-items-center">


                        <div class="col-md-8">


                            <div class="d-flex align-items-center">


                                <!-- AVATAR -->

                                <div class="applicant-avatar me-3">

                                    <%= application.applicant_name
                                        ? application.applicant_name
                                            .charAt(0)
                                            .toUpperCase()
                                        : "?" %>

                                </div>


                                <!-- APPLICANT -->

                                <div>

                                    <h4 class="mb-1">

                                        <%= application.applicant_name %>

                                    </h4>


                                    <p class="text-muted mb-0">

                                        Application #<%= index + 1 %>

                                    </p>

                                </div>


                            </div>


                        </div>


                        <!-- MATCH SCORE -->

                        <div class="col-md-4 text-md-end mt-3 mt-md-0">


                            <small class="text-muted">

                                🤖 Resume Match

                            </small>


                            <div>

                                <%
                                    const score =
                                        Number(
                                            application.match_score || 0
                                        );
                                %>


                                <% if (score >= 70) { %>

                                    <span
                                        class="badge bg-success match-score"
                                    >

                                        <%= score %>%

                                    </span>


                                <% } else if (score >= 40) { %>

                                    <span
                                        class="badge bg-warning text-dark match-score"
                                    >

                                        <%= score %>%

                                    </span>


                                <% } else { %>

                                    <span
                                        class="badge bg-danger match-score"
                                    >

                                        <%= score %>%

                                    </span>

                                <% } %>


                            </div>


                        </div>


                    </div>


                    <hr>


                    <!-- JOB INFORMATION -->

                    <div class="row mb-3">


                        <div class="col-md-4">

                            <strong>
                                💼 Job
                            </strong>

                            <p class="mb-0">

                                <%= application.job_title || "Not available" %>

                            </p>

                        </div>


                        <div class="col-md-4">

                            <strong>
                                🏢 Company
                            </strong>

                            <p class="mb-0">

                                <%= application.company || "Not available" %>

                            </p>

                        </div>


                        <div class="col-md-4">

                            <strong>
                                📍 Location
                            </strong>

                            <p class="mb-0">

                                <%= application.location || "Not available" %>

                            </p>

                        </div>


                    </div>


                    <!-- CONTACT INFORMATION -->

                    <div class="row mb-3">


                        <div class="col-md-6">

                            <strong>
                                📧 Email
                            </strong>

                            <p class="mb-0">

                                <%= application.email || "Not provided" %>

                            </p>

                        </div>


                        <div class="col-md-6">

                            <strong>
                                📞 Phone
                            </strong>

                            <p class="mb-0">

                                <%= application.phone || "Not provided" %>

                            </p>

                        </div>


                    </div>


                    <hr>


                    <!-- SKILLS -->

                    <div class="mb-3">

                        <strong>
                            🛠 Candidate Skills
                        </strong>


                        <div class="skills-box mt-2">

                            <%= application.skills || "Not provided" %>

                        </div>

                    </div>


                    <!-- COVER LETTER -->

                    <div class="mb-3">

                        <strong>
                            📝 Cover Letter
                        </strong>


                        <div class="cover-box mt-2">

                            <%= application.cover_letter || "Not provided" %>

                        </div>

                    </div>


                    <!-- MATCH INFORMATION -->

                    <div class="mb-3">

                        <strong>
                            🤖 Resume Analysis
                        </strong>


                        <div class="mt-2">


                            <% if (application.match_score >= 70) { %>

                                <span class="badge bg-success">
                                    Excellent Match
                                </span>


                            <% } else if (application.match_score >= 40) { %>

                                <span class="badge bg-warning text-dark">
                                    Good Match
                                </span>


                            <% } else { %>

                                <span class="badge bg-secondary">
                                    Low Match
                                </span>

                            <% } %>


                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="mb-3">

                        <strong>
                            Status:
                        </strong>


                        <% if (application.status === "Accepted") { %>

                            <span class="badge bg-success">

                                ✅ Accepted

                            </span>


                        <% } else if (application.status === "Rejected") { %>

                            <span class="badge bg-danger">

                                ❌ Rejected

                            </span>


                        <% } else { %>

                            <span class="badge bg-secondary">

                                🕐 Applied

                            </span>

                        <% } %>


                    </div>


                    <!-- ACTION BUTTONS -->

                    <div class="action-buttons">


                        <!-- VIEW RESUME -->

                        <% if (application.resume_link) { %>

                            <a
                                href="/uploads/<%= application.resume_link %>"
                                target="_blank"
                                class="btn btn-outline-primary btn-sm"
                            >

                                📄 View Resume

                            </a>

                        <% } %>


                        <!-- VIEW APPLICATION -->

                        <a
                            href="/applications/<%= application.id %>"
                            class="btn btn-outline-dark btn-sm"
                        >

                            👁 View Application

                        </a>


                        <!-- ACCEPT -->

                        <% if (application.status !== "Accepted") { %>

                            <form
                                action="/applications/<%= application.id %>/accept"
                                method="POST"
                                class="d-inline"
                            >

                                <button
                                    type="submit"
                                    class="btn btn-success btn-sm"
                                    onclick="return confirm('Accept this applicant?');"
                                >

                                    ✅ Accept

                                </button>

                            </form>

                        <% } %>


                        <!-- DELETE -->

                        <form
                            action="/applications/<%= application.id %>/delete"
                            method="POST"
                            class="d-inline"
                            onsubmit="return confirm('Are you sure you want to delete this application?');"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger btn-sm"
                            >

                                🗑 Delete

                            </button>

                        </form>


                    </div>


                </div>

            </div>


        <% }) %>


    <% } %>


</div>


</body>

</html>