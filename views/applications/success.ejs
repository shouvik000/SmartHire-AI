<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Application Submitted | SmartHire AI</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f4f7fb;
        }

        .success-card {
            max-width: 750px;
            margin: 70px auto;
            border: none;
            border-radius: 20px;
            overflow: hidden;
        }

        .success-icon {
            font-size: 70px;
        }

        .score {
            font-size: 60px;
            font-weight: bold;
        }

        .skill-badge {
            font-size: 14px;
            margin: 4px;
            padding: 8px 12px;
        }

        .analysis-box {
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
        }

    </style>

</head>


<body>


<div class="container">

    <div class="card shadow success-card">

        <div class="card-body text-center p-5">


            <!-- SUCCESS ICON -->

            <div class="success-icon">
                🎉
            </div>


            <!-- TITLE -->

            <h1 class="text-success">

                Application Submitted Successfully!

            </h1>


            <!-- APPLICANT -->

            <p class="lead mt-3">

                Thank you,

                <strong>
                    <%= applicantName %>
                </strong>

            </p>


            <!-- JOB -->

            <p>

                Your application for

                <strong>
                    <%= jobTitle %>
                </strong>

                has been submitted successfully.

            </p>


            <hr>


            <!-- RESUME ANALYSIS -->

            <h4 class="mt-4">

                🤖 AI Resume Analysis

            </h4>


            <!-- MATCH SCORE -->

            <div class="score text-primary">

                <%= matchScore %>%

            </div>


            <p class="text-muted">

                Resume Match Score

            </p>



            <!-- ================================= -->
            <!-- MATCHED SKILLS -->
            <!-- ================================= -->

            <div class="analysis-box bg-light text-start">

                <h5 class="text-success">

                    ✅ Matched Skills

                </h5>


                <% if (matchedSkills && matchedSkills.length > 0) { %>

                    <div class="mt-2">

                        <% matchedSkills.forEach(skill => { %>

                            <span class="badge bg-success skill-badge">

                                <%= skill %>

                            </span>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p class="text-muted mb-0">

                        No matching skills found.

                    </p>

                <% } %>

            </div>



            <!-- ================================= -->
            <!-- MISSING SKILLS -->
            <!-- ================================= -->

            <div class="analysis-box bg-light text-start">

                <h5 class="text-danger">

                    ❌ Missing Skills

                </h5>


                <% if (missingSkills && missingSkills.length > 0) { %>

                    <div class="mt-2">

                        <% missingSkills.forEach(skill => { %>

                            <span class="badge bg-danger skill-badge">

                                <%= skill %>

                            </span>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p class="text-success mb-0">

                        🎯 Excellent! No required skills are missing.

                    </p>

                <% } %>

            </div>



            <!-- ================================= -->
            <!-- RECOMMENDATION -->
            <!-- ================================= -->

            <div class="mt-4">

                <% if (matchScore >= 80) { %>

                    <div class="alert alert-success">

                        <h5>

                            🎯 Excellent Match

                        </h5>

                        <p class="mb-0">

                            Your resume strongly matches
                            the skills required for this job.

                        </p>

                    </div>

                <% } else if (matchScore >= 60) { %>

                    <div class="alert alert-primary">

                        <h5>

                            👍 Good Match

                        </h5>

                        <p class="mb-0">

                            Your resume matches most of
                            the important skills for this position.

                        </p>

                    </div>

                <% } else if (matchScore >= 40) { %>

                    <div class="alert alert-warning">

                        <h5>

                            ⚠️ Moderate Match

                        </h5>

                        <p class="mb-0">

                            You have some relevant skills,
                            but improving the missing skills
                            could strengthen your application.

                        </p>

                    </div>

                <% } else { %>

                    <div class="alert alert-danger">

                        <h5>

                            📚 Low Match

                        </h5>

                        <p class="mb-0">

                            Your resume currently has limited
                            overlap with the required skills.

                        </p>

                    </div>

                <% } %>

            </div>



            <!-- ================================= -->
            <!-- BUTTONS -->
            <!-- ================================= -->

            <div class="mt-4">

                <a
                    href="/jobs"
                    class="btn btn-primary me-2"
                >

                    Browse More Jobs

                </a>


                <a
                    href="/dashboard"
                    class="btn btn-outline-dark"
                >

                    Dashboard

                </a>

            </div>


        </div>

    </div>

</div>


</body>

</html>