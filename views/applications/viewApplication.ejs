<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Application Details | SmartHire AI
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">


<div class="container mt-5 mb-5">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>
                👤 Candidate Application
            </h2>

            <p class="text-muted">
                SmartHire AI Recruiter Panel
            </p>

        </div>


        <a
            href="/applications"
            class="btn btn-outline-primary"
        >
            ← Back to Applications
        </a>

    </div>



    <!-- CANDIDATE -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <h3>
                <%= application.applicant_name %>
            </h3>

            <p class="mb-1">

                <strong>Email:</strong>

                <%= application.email %>

            </p>


            <p class="mb-1">

                <strong>Phone:</strong>

                <%= application.phone %>

            </p>


            <p class="mb-1">

                <strong>Applied For:</strong>

                <%= application.job_title %>

            </p>


            <p>

                <strong>Company:</strong>

                <%= application.company %>

            </p>

        </div>

    </div>



    <!-- MATCH SCORE -->

    <div class="card shadow mb-4">

        <div class="card-body text-center">

            <h4>
                🤖 Resume Match Score
            </h4>


            <% const score =
                Number(application.match_score || 0);
            %>


            <div class="display-3 fw-bold text-primary">

                <%= score %>%

            </div>


            <% if (score >= 70) { %>

                <div class="alert alert-success">

                    🎯 Excellent Match

                </div>

            <% } else if (score >= 40) { %>

                <div class="alert alert-warning">

                    👍 Moderate Match

                </div>

            <% } else { %>

                <div class="alert alert-danger">

                    ⚠️ Low Match

                </div>

            <% } %>

        </div>

    </div>



    <!-- SKILLS -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <h4>
                🛠 Candidate Skills
            </h4>

            <p>

                <%= application.skills || "Not provided" %>

            </p>


            <hr>


            <h5>
                Required Skills
            </h5>

            <p>

                <%= application.required_skills ||
                    "Not specified" %>

            </p>

        </div>

    </div>



    <!-- COVER LETTER -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <h4>
                📝 Cover Letter
            </h4>

            <p>

                <%= application.cover_letter ||
                    "No cover letter provided." %>

            </p>

        </div>

    </div>



    <!-- RESUME -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <h4>
                📄 Resume
            </h4>


            <% if (application.resume_link) { %>

                <a
                    href="/uploads/<%= application.resume_link %>"
                    target="_blank"
                    class="btn btn-primary"
                >
                    View Resume
                </a>

            <% } else { %>

                <p class="text-muted">
                    Resume not uploaded.
                </p>

            <% } %>

        </div>

    </div>



    <!-- APPLICATION STATUS -->

    <div class="card shadow">

        <div class="card-body">

            <h4>
                📌 Application Status
            </h4>


            <p>

                Current Status:

                <span class="badge bg-secondary">

                    <%= application.status || "Applied" %>

                </span>

            </p>


            <form
                action="/applications/<%= application.id %>/status"
                method="POST"
            >

                <div class="mb-3">

                    <label class="form-label">

                        Update Status

                    </label>


                    <select
                        name="status"
                        class="form-select"
                    >

                        <option value="Applied">
                            Applied
                        </option>

                        <option value="Shortlisted">
                            Shortlisted
                        </option>

                        <option value="Accepted">
                            Accepted
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                    </select>

                </div>


                <button
                    type="submit"
                    class="btn btn-success"
                >

                    Update Status

                </button>

            </form>

        </div>

    </div>


</div>


</body>

</html>