<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add New Job | SmartHire AI</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/dashboard">
            🚀 SmartHire AI
        </a>

        <a href="/jobs" class="btn btn-outline-light">
            View Jobs
        </a>

    </div>

</nav>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white">

                    <h2 class="mb-0">
                        💼 Post a New Job
                    </h2>

                </div>

                <div class="card-body">

                    <form action="/jobs/add" method="POST">

                        <div class="mb-3">

                            <label class="form-label">
                                Job Title
                            </label>

                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                placeholder="Backend Developer"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Company
                            </label>

                            <input
                                type="text"
                                name="company"
                                class="form-control"
                                placeholder="Google"
                                required>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Location
                                </label>

                                <input
                                    type="text"
                                    name="location"
                                    class="form-control"
                                    placeholder="Bangalore"
                                    required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Salary
                                </label>

                                <input
                                    type="text"
                                    name="salary"
                                    class="form-control"
                                    placeholder="₹6 LPA"
                                    required>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Required Skills
                            </label>

                            <input
                                type="text"
                                name="required_skills"
                                class="form-control"
                                placeholder="Node.js, Express.js, PostgreSQL, JWT">

                            <small class="text-muted">
                                Separate skills using commas.
                            </small>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Job Description
                            </label>

                            <textarea
                                name="description"
                                rows="6"
                                class="form-control"
                                placeholder="Describe the job role..."
                                required></textarea>

                        </div>

                        <div class="d-grid">

                            <button class="btn btn-primary btn-lg">

                                🚀 Post Job

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>

</html>